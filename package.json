{
  "name": "openwp",
  "version": "0.1.4",
  "description": "Plugin-native AI agent operating system for WordPress with strict action guardrails.",
  "private": true,
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "lint:js": "wp-scripts lint-js src",
    "lint:css": "wp-scripts lint-style src",
    "format": "wp-scripts format src",
    "i18n": "wp i18n make-pot . --skip-audit --exclude='.github,docs,src,node_modules,tests,vendor,build,.browserslistrc,postcss.config.js,tailwind.config.js,webpack.config.js,package.json,package-lock.json,*.json' languages/openwp.pot",
    "i18n:po": "wp i18n update-po languages/openwp.pot",
    "i18n:mo": "wp i18n make-mo languages",
    "i18n:json": "wp i18n make-json languages --no-purge"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0",
    "autoprefixer": "^10.4.21",
    "grunt": "^1.6.1",
    "grunt-bumpup": "^0.6.3",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-compress": "^2.0.0",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-rtlcss": "^2.0.2",
    "grunt-text-replace": "^0.4.0",
    "grunt-wp-readme-to-markdown": "^2.1.0",
    "tailwindcss": "^3.4.17"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "overrides": {
    "@babel/core": "7.29.6",
    "@opentelemetry/instrumentation-amqplib": "0.47.0",
    "@opentelemetry/instrumentation-connect": "0.44.0",
    "@opentelemetry/instrumentation-express": "0.48.0",
    "@opentelemetry/instrumentation-fs": "0.20.0",
    "@opentelemetry/instrumentation-hapi": "0.46.0",
    "@opentelemetry/instrumentation-http": "0.219.0",
    "@opentelemetry/instrumentation-koa": "0.48.0",
    "@opentelemetry/instrumentation-mongoose": "0.47.0",
    "@opentelemetry/instrumentation-mysql2": "0.46.0",
    "@opentelemetry/instrumentation-pg": "0.52.0",
    "@opentelemetry/instrumentation-undici": "0.11.0",
    "@opentelemetry/sql-common": "0.41.0",
    "adm-zip": "0.6.0",
    "markdownlint": "0.38.0",
    "markdownlint-cli": "0.49.0",
    "minimatch": "3.1.5",
    "qs": "6.16.0",
    "semver": "7.7.4",
    "glob": "7.2.3",
    "js-yaml": "4.3.2",
    "markdown-it": "14.2.0",
    "smol-toml": "1.6.1"
